# Copie ce fichier en .env puis renseigne tes valeurs :  cp .env.example .env
# Les scripts font :  set -a; source .env; set +a

# --- Obligatoire ---
export PROJECT_ID="mon-projet-gcp"        # ton projet GCP (avec facturation activée)
export DATASET="retail_poc"               # dataset BigQuery créé par le POC

# --- Régions ---
# BigQuery + les scans Dataplex doivent être dans la MÊME région/multirégion.
export BQ_LOCATION="EU"                    # multirégion du dataset BigQuery (EU ou US)
export DPLX_LOCATION="europe-west1"        # région Dataplex des datascans (ex: europe-west1, us-central1)

# --- Agent conversationnel (Conversational Analytics API) ---
# L'API est régionalisée ; "global" est souvent le plus simple pour démarrer.
export AGENT_LOCATION="global"
export AGENT_ID="agent-ventes-poc"
